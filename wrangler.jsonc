{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "disneito-web",
  "main": "./worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./disenador-web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {
    "ai": {
      "binding": "AI"
    }
  },
  "vars": {
    "MASTER_USER_ID": "9c79c647-0b20-4be1-8516-3d2a76971b9d"
  },
  "kv_namespaces": [
    {
      "binding": "MASTER_TEST_STATS"
    }
  ]
}
